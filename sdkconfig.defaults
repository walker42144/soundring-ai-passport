# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_14=y
# SoundRing 用自带中文子集字体，关闭未使用的内置 Montserrat 20 以省 Flash。
CONFIG_LV_FONT_MONTSERRAT_20=n
# LVGL 内置 malloc 池（字节）。独立静态区，不与系统堆共享；遥控界面用 40KB。
CONFIG_LV_MEM_SIZE=28672
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_BUILD_EXAMPLES=n

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- 网络 / TLS ---
# 使用 ESP-IDF 内置根证书包校验证书；时间由 SNTP 提供。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# 无 PSRAM：收缩 mbedTLS 记录缓冲，避免 TLS 握手挤爆内部 RAM。
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
# 无 PSRAM 且 Wi-Fi 常驻：收紧缩 Wi-Fi 缓冲，把内部 RAM 留给 TLS 握手（默认值会吃掉 20 KB+）。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
CONFIG_LIBC_TIME_SYSCALL_USE_RTC_HRT=y

# --- Bluetooth LE / NimBLE ---
# 遥控器不使用蓝牙：关闭协议栈，把内部 RAM 留给 Wi-Fi + TLS + 封面解码。
CONFIG_BT_ENABLED=n

# --- 电源管理 ---
# 息屏时停 LVGL 任务与刷新，空闲时允许 tickless idle 降耗。
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# --- 编译 ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
